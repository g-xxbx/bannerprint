# syntax=docker/dockerfile:1.7
#
# server 镜像：多阶段构建 + scratch 运行期
#   - 构建阶段安装依赖并静态编译（CGO_ENABLED=0）
#   - 运行阶段只保留二进制，默认非 root（65532），无 shell、无包管理器
#   - 版本号通过 build-arg 注入，镜像可复现

ARG GO_VERSION=1.23

FROM golang:${GO_VERSION}-alpine AS build
WORKDIR /src

ENV CGO_ENABLED=0 \
    GOTOOLCHAIN=local

# 依赖层单独缓存：只要 go.mod/go.sum 不变，后续改代码不会重新下载依赖。
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY . .

ARG VERSION=dev
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go build -trimpath -ldflags="-s -w -X main.version=${VERSION}" -o /out/server ./cmd/server

FROM scratch
COPY --from=build /out/server /app/server

# 非 root、无 shell、只读根文件系统由 compose 进一步收紧。
USER 65532:65532
EXPOSE 8080

ENTRYPOINT ["/app/server"]
