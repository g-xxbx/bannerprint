# client 镜像：与 server 相同的多阶段 + scratch 策略。
# 输入文件以只读方式挂载，识别完成后进程退出。

ARG GO_VERSION=1.23

FROM golang:${GO_VERSION}-alpine AS build
WORKDIR /src

ENV CGO_ENABLED=0 \
    GOTOOLCHAIN=local \
    GOFLAGS=-mod=vendor

COPY go.mod go.sum ./
COPY vendor ./vendor
COPY cmd ./cmd
COPY internal ./internal
COPY rules ./rules

ARG VERSION=dev
RUN --mount=type=cache,target=/root/.cache/go-build \
    go build -trimpath -ldflags="-s -w -X main.version=${VERSION}" -o /out/client ./cmd/client

FROM scratch
COPY --from=build /out/client /app/client

USER 65532:65532

ENTRYPOINT ["/app/client"]
